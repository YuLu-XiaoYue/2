{
  "name": "lock-kingdom-warehouse",
  "version": "1.0.0",
  "description": "洛克王国精灵蛋仓库",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.lock.warehouse",
    "productName": "洛克仓库",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/green_nest.png"
    },
    "extraResources": [
      "icons/**/*"
    ]
  },
  "devDependencies": {
    "electron": "28.0.0",
    "electron-builder": "24.9.1"
  },
  "dependencies": {
    "sqlite3": "5.1.7"
  }
}
